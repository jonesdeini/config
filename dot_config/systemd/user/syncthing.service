[Unit]
Description=Syncthing - personal continuous file synchronization
Documentation=man:syncthing(1)
After=network.target

[Service]
ExecStart=%h/.local/share/mise/shims/syncthing serve --no-browser
Restart=on-failure
RestartSec=5
SuccessExitStatus=3 4
RestartForceExitStatus=3 4

[Install]
WantedBy=default.target
